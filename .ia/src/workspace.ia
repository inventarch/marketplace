#! ia 1.0

@workspace inventarch-marketplace
  meaning
    says "The authored source boundary for the public InventArch plugin catalogue: the ia plugin and the public method kits it carries."
    answers "Which sources and existing systems describe this catalogue?"
  composition
    systems [@system workspace-system, @system work-system, @system learning-system]
    sources [".ia/src @authored"]

@spec marketplace-front-door
  meaning
    says "The catalogue's front door: what the core plugin and its default kits are for, how kits are named, how to install the catalogue in Claude Code and Codex, how to connect an InventArch account, and the gates a contributor runs."
    answers "What is in this catalogue, and how does an engineer install it?"
  work
    title "InventArch marketplace README"
    status draft
    owner "InventArch maintainers"
    source "README.md"

@spec marketplace-agent-rules
  meaning
    says "The working rules for agents and engineers in this repository: what may ship, the plugin rules, the kit rules, the gates, and what validation never does (push, publish, invite or change access)."
    answers "What must an agent working in this repository follow?"
  work
    title "Work boundaries for this repository"
    status draft
    owner "InventArch maintainers"
    source "AGENTS.md"

@spec marketplace-core-plugin
  meaning
    says "The ia plugin: the Work, Knowledge and Delivery lanes, the init and doctor skills, the resolver over ia position, the reader, checker and worker profiles, the kit lookup, install and bind verbs, the read-only session and on-write hooks, and the bundled default kits."
    answers "What does the ia plugin do, and how is it built?"
  work
    title "The ia plugin"
    status draft
    owner "InventArch maintainers"
    source "plugins/ia/README.md"
    covers ["plugins/ia/"]

@spec marketplace-kits
  meaning
    says "The kit sources: each public kit's records, sidecars and per-version release history, the bundle map into the core, the root kit index, and the maintainer workflow that packs, records and bundles a release."
    answers "Where are the kits authored, and how is a kit released?"
  work
    title "Kit sources"
    status draft
    owner "InventArch maintainers"
    source "kits/README.md"
    covers ["kits/"]

@spec marketplace-addition
  meaning
    says "How a plugin or kit is added or changed without widening authority: layout, manifests, the export selection, the validator and consistency rules, and the tests that hold them."
    answers "How is a plugin added or changed in this catalogue?"
  work
    title "Add or change a plugin"
    status draft
    owner "InventArch maintainers"
    source "docs/adding-plugins.md"
    covers ["docs/adding-plugins.md", "tools/", "schemas/", "tests/", "export-selection.json", "sources.lock.json"]

@spec marketplace-hosts
  meaning
    says "What each host (Claude Code, Codex) loads from this catalogue, which hooks run where, and what has been qualified on a real host."
    answers "Which hosts does the catalogue support, and what is proven on each?"
  work
    title "Host support"
    status draft
    owner "InventArch maintainers"
    source "docs/hosts.md"

@spec marketplace-public-kits
  meaning
    says "The @inventarch/public-kits npm package: what it carries (each bundled kit's IA archive, manifest and folder, and the kit index), how tools/kit.mjs package generates and checks it, why its built files are not committed, and the operator's publish workflow."
    answers "How are the default kits packaged for npm, and how is the package published?"
  work
    title "The public kits package"
    status draft
    owner "InventArch maintainers"
    source "docs/public-kits-package.md"
    covers ["packages/", ".github/workflows/publish-public-kits.yml"]

@spec marketplace-contributing
  meaning
    says "How to contribute to the public catalogue: where to report bugs, proposals and security problems, the code of conduct, the prerequisites and gates, the release-note rule, the pull request rules the main rulesets enforce, and the licence of contributions; with the issue and pull request templates, the code owners, Dependabot's configuration and the rulesets themselves."
    answers "How does someone outside the maintainers report a problem or contribute a change, and what protects main?"
  work
    title "Contributing, support and security"
    status draft
    owner "InventArch maintainers"
    source "CONTRIBUTING.md"
    covers ["SECURITY.md", "SUPPORT.md", "CODE_OF_CONDUCT.md", ".github/ISSUE_TEMPLATE/", ".github/PULL_REQUEST_TEMPLATE.md", ".github/CODEOWNERS", ".github/dependabot.yml", ".github/rulesets/"]

@spec marketplace-releases
  meaning
    says "How a plugin is released: the pending release notes a pull request adds, the changesets a release records, the operator-started release pull request that folds the notes into the next version, the release workflow that tags a merged release, and the checks that hold them."
    answers "How does a change to a plugin become a released, tagged version?"
  work
    title "Releases"
    status draft
    owner "InventArch maintainers"
    source "releases/README.md"
    covers ["releases/", ".github/workflows/release-pr.yml", ".github/workflows/release.yml"]

@spec publication-identity-screening
  meaning
    says "Defines bounded publisher-side screening of exact frozen text artifacts against an external operator-selected private-identity registry, with unavailable input never reported as pass."
  work
    title "Publisher identity screening"
    status draft
    owner "InventArch maintainers"
    source "docs/kit-contract/SCREENING-SPEC.md"
    covers ["tools/check-identities.mjs", "tests/check-identities.test.mjs", "docs/kit-contract/SCREENING-SPEC.md", "docs/kit-contract/screening-review.md", "docs/kit-contract/screening-verification.md"]

@spec kit-contract-public-baseline
  meaning
    says "Preserves proposed public kit-contract expectation data and normative context with integrity tests, without claiming behavioral execution, native admission or release permission."
  work
    title "Public kit contract expectation baseline"
    status draft
    owner "InventArch maintainers"
    source "docs/kit-contract/SPEC.md"
    covers ["docs/kit-contract/SPEC.md", "docs/kit-contract/expectations.json", "docs/kit-contract/context.md", "docs/kit-contract/review.md", "docs/kit-contract/verification.md", "tests/kit-contract-baseline.test.mjs"]
